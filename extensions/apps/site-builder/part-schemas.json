{
  "product-card": {
    "version": 1,
    "config": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "format": "product-id"
        },
        "priceKind": {
          "default": "gross",
          "type": "string",
          "enum": ["gross", "net"]
        }
      },
      "required": ["productId"]
    }
  },
  "product-summary": {
    "version": 1,
    "config": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "format": "product-id"
        }
      },
      "required": ["productId"]
    }
  }
}

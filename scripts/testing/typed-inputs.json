{
  "categories": {
    "model-output-repair": "Structural merge or repair of untrusted model output (app manifests and briefs) before it is parsed into the typed Manifest; the JSON level is the subject of these functions.",
    "structural-validation": "Key-by-key validation of schema-less documents (rich text, image job input, review import, app field values) whose admission defines the accepted shape; typing them first would accept or reject differently.",
    "keyed-lookup": "Lookups by a runtime key in keyed maps (rule ids, event paths, configured fields, provider ids, consent purposes) whose keys are data, not field names.",
    "in-place-edit": "Functions that rewrite a stored document in place (product restore, history restoration, cart and order projections, delivery dates) and read the fields they are about to change.",
    "attempt-context": "The per-attempt provider context of the payment ledger, a keyed document of receipts and settlements read and written together across the ledger modules.",
    "protocol-adapter": "Translation of an external wire protocol (UCP documents and profiles, the MCP JSON-RPC envelope) at the adapter boundary."
  },

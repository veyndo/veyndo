      "audit",
      "apps"
    ],
    "kind": "customer.updated",
    "producers": [
      {
        "component": "customers",
        "crate": "veyndo-customers",
        "source": "rust",
        "type": "CustomerUpdated"
      }
    ],
    "version": 1
  }
}

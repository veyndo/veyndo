{
  "$id": "payment.instrument.revoked.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A customer revoked an active saved payment method.",
  "properties": {
    "instrumentId": {
      "type": "string"
    }
  },
  "required": [
    "instrumentId"
  ],
  "title": "payment.instrument.revoked",
  "type": "object",
  "x-veyndo-event": {
    "consumers": [
      "audit",
      "apps",
      "flows"
    ],
    "kind": "payment.instrument.revoked",
    "producers": [
      {
        "component": "payments",
        "crate": "veyndo-payments",
        "source": "rust",
        "type": "InstrumentRevoked"
      }
    ],
    "version": 1
  }
}

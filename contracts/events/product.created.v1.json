{
  "$id": "product.created.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The merchant product editor created (`product.created`) or saved (`product.updated`) a product.",
  "properties": {
    "productId": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    }
  },
  "required": [
    "productId",
    "revision"
  ],
  "title": "product.created",
  "type": "object",
  "x-veyndo-event": {
    "consumers": [
      "audit",
      "apps",
      "flows"
    ],
    "kind": "product.created",
    "producers": [
      {
        "component": "studio",
        "crate": "veyndo-studio",
        "source": "rust",
        "type": "ProductSaved"
      }
    ],
    "version": 1
  }
}

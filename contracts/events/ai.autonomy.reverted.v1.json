{
  "$id": "ai.autonomy.reverted.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Autonomous price changes were reverted, by the merchant or automatically.",
  "properties": {
    "actor": {
      "type": "string"
    },
    "automatic": {
      "type": "boolean"
    },
    "productIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "actor",
    "automatic",
    "productIds"
  ],
  "title": "ai.autonomy.reverted",
  "type": "object",
  "x-veyndo-event": {
    "consumers": [
      "audit",
      "apps"
    ],
    "kind": "ai.autonomy.reverted",
    "producers": [
      {
        "component": "intelligence",
        "crate": "veyndo-intelligence",
        "source": "rust",
        "type": "AutonomyReverted"
      }
    ],
    "version": 1
  }
}

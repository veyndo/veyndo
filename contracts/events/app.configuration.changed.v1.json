{
  "$id": "app.configuration.changed.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An app configured (or removed) its product configuration in a cart; `products` are the configured product IDs.",
  "properties": {
    "app": {
      "type": "string"
    },
    "cartId": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "products": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "revision": {
      "type": "integer"
    },
    "salesChannelId": {
      "type": "string"
    }
  },
  "required": [
    "app",
    "cartId",
    "operation",
    "products",
    "revision",
    "salesChannelId"
  ],
  "title": "app.configuration.changed",
  "type": "object",
  "x-veyndo-event": {
    "consumers": [
      "audit",
      "apps",
      "flows"
    ],
    "kind": "app.configuration.changed",
    "producers": [
      {
        "component": "apps",
        "crate": "veyndo-app-platform",
        "source": "rust",
        "type": "ConfigurationChanged"
      }
    ],
    "version": 1
  }
}

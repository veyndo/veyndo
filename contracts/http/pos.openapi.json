              "schema": {
                "type": "object"
              }
            }
          }
        },
        "x-veyndo-permission": "pos.use",
        "security": [
          {
            "personalSession": []
          },
          {
            "integrationKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "One safe, actionable failure; never contains SQL or provider payloads.",
        "required": [
          "kind",
          "retryable",
          "code",
          "status",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "validation_error",
              "authentication_required",
              "permission_denied",
              "not_found",
              "conflict",
              "quota_exceeded",
              "rate_limited",
              "temporarily_unavailable",
              "provider_unavailable",
              "internal_error",
              "revision_conflict",
              "output_contract_error"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "currentRevision": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "HTTP status code as a string (compatible legacy field)"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "PosCustomersInput": {
        "additionalProperties": false,
        "properties": {
          "barcode": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "query": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "channelId"
        ],
        "type": "object"
      },
      "PosCustomerInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "customerId": {
            "maxLength": 100,
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "revision",
          "customerId"
        ],
        "type": "object"
      },
      "PosDiscountInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "discount": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "currency": {
                    "maxLength": 3,
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "percent",
                      "fixed"
                    ]
                  },
                  "reason": {
                    "maxLength": 240,
                    "minLength": 1,
                    "type": "string"
                  },
                  "value": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "value",
                  "currency",
                  "reason"
                ],
                "type": "object"
              }
            ]
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "revision",
          "discount"
        ],
        "type": "object"
      },
      "PosReceiptInput": {
        "additionalProperties": false,
        "properties": {
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "receiptId": {
            "type": "string"
          }
        },
        "required": [
          "channelId",
          "orderId",
          "receiptId"
        ],
        "type": "object"
      },
      "PosChannelsInput": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "PosPaymentInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "channelId",
          "cartToken"
        ],
        "type": "object"
      },
      "PosReconcileInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "requestKey": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "requestKey"
        ],
        "type": "object"
      },
      "PosCatalogInput": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "maxLength": 200,
            "type": "string"
          },
          "barcode": {
            "maxLength": 100,
            "type": "string"
          },
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "query": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "channelId"
        ],
        "type": "object"
      },
      "PosContextInput": {
        "additionalProperties": false,
        "properties": {
          "channelId": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "channelId"
        ],
        "type": "object"
      },
      "PosDetailInput": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "type": "string"
          },
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "productId": {
            "type": "string"
          }
        },
        "required": [
          "channelId",
          "productId"
        ],
        "type": "object"
      },
      "PosCurrencyInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "currency": {
            "maxLength": 3,
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "revision",
          "currency"
        ],
        "type": "object"
      },
      "PosCouponsInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "codes": {
            "items": {
              "maxLength": 64,
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "revision",
          "codes"
        ],
        "type": "object"
      },
      "PosCreateInput": {
        "additionalProperties": false,
        "properties": {
          "channelId": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "channelId"
        ],
        "type": "object"
      },
      "PosCartInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "channelId",
          "cartToken"
        ],
        "type": "object"
      },
      "PosReplaceInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "quantity"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "type": "array"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "revision",
          "items"
        ],
        "type": "object"
      },
      "PosSelectInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "checkout": {
            "type": "object"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "revision",
          "checkout"
        ],
        "type": "object"
      },
      "PosAcceptInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "digitalImmediate": {
            "type": "boolean"
          },
          "policyVersion": {
            "type": "string"
          },
          "terms": {
            "type": "boolean"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "terms",
          "digitalImmediate",
          "policyVersion"
        ],
        "type": "object"
      },
      "PosCompleteInput": {
        "additionalProperties": false,
        "properties": {
          "cartToken": {
            "maxLength": 100,
            "type": "string"
          },
          "channelId": {
            "maxLength": 100,
            "type": "string"
          },
          "requestKey": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "tenderMinor": {
            "pattern": "^[0-9]{1,13}$",
            "type": "string"
          },
          "totalMinor": {
            "pattern": "^[0-9]{1,13}$",
            "type": "string"
          }
        },
        "required": [
          "channelId",
          "cartToken",
          "revision",
          "requestKey",
          "totalMinor"
        ],
        "type": "object"
      },
      "PosHeldInput": {
        "additionalProperties": false,
        "properties": {
          "channelId": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "channelId"
        ],
        "type": "object"
      },
      "PosSalesInput": {
        "additionalProperties": false,
        "properties": {
          "channelId": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "channelId"
        ],
        "type": "object"
      }
    },
    "parameters": {
      "Tenant": {
        "name": "x-tenant",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Shop ID. Required for shop-scoped calls without a session that already selects one."
      }
    },
    "securitySchemes": {
      "personalSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal merchant session token from POST /api/auth/login or /api/auth/register."
      },
      "integrationKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped integration key from POST /api/workspace/integrations; intersects its creator's current membership."
      }
    }
  },
  "x-veyndo-tools": [
    {
      "name": "pos.customers",
      "description": "Search active tenant customers or resolve a customer-number card",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCustomersInput"
      }
    },
    {
      "name": "pos.customer",
      "description": "Revision-checked cashier attachment of an existing customer",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCustomerInput"
      }
    },
    {
      "name": "pos.discount",
      "description": "Audited exact cashier discount through shared pricing",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosDiscountInput"
      }
    },
    {
      "name": "pos.receipt",
      "description": "Read printable lines from an existing immutable issued invoice",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosReceiptInput"
      }
    },
    {
      "name": "pos.channels",
      "description": "Discover the tenant POS registers through cashier admission",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosChannelsInput"
      }
    },
    {
      "name": "pos.payment",
      "description": "Read the owned sale payment and authoritative order",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosPaymentInput"
      }
    },
    {
      "name": "pos.reconcile",
      "description": "Reconcile the owned provider attempt through existing durable jobs",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosReconcileInput"
      }
    },
    {
      "name": "pos.catalog",
      "description": "Search channel products or resolve a barcode for an authenticated cashier",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCatalogInput"
      }
    },
    {
      "name": "pos.context",
      "description": "Read POS configuration without creating a cart",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosContextInput"
      }
    },
    {
      "name": "pos.detail",
      "description": "Read native product families and variant prices",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosDetailInput"
      }
    },
    {
      "name": "pos.currency",
      "description": "Select an enabled channel currency through native pricing",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCurrencyInput"
      }
    },
    {
      "name": "pos.coupons",
      "description": "Apply coupon codes through the native promotion owner",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCouponsInput"
      }
    },
    {
      "name": "pos.create",
      "description": "Create an actor-bound native POS cart",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCreateInput"
      }
    },
    {
      "name": "pos.cart",
      "description": "Read an owned POS cart and its authoritative quote",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCartInput"
      }
    },
    {
      "name": "pos.replace",
      "description": "Revision-checked native POS cart edit",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosReplaceInput"
      }
    },
    {
      "name": "pos.select",
      "description": "Select customer/contact and a configured payment through the shared checkout",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosSelectInput"
      }
    },
    {
      "name": "pos.accept",
      "description": "Record explicit current legal acknowledgements through the shared legal owner",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosAcceptInput"
      }
    },
    {
      "name": "pos.complete",
      "description": "Idempotent native POS checkout, cash tender in exact currency minor units",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosCompleteInput"
      }
    },
    {
      "name": "pos.held",
      "description": "List this cashier's held carts in this sales channel",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosHeldInput"
      }
    },
    {
      "name": "pos.sales",
      "description": "Read recent channel orders and cash tender records",
      "readOnly": false,
      "input": {
        "$ref": "#/components/schemas/PosSalesInput"
      }
    }
  ],
  "x-veyndo-component": "pos"
}

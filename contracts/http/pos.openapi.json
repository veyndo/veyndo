                }
              }
            }
          }
        },
        "x-veyndo-source": "src/pos/mod.rs",
        "x-veyndo-permission": "pos.use",
        "security": [
          {
            "personalSession": []
          },
          {
            "integrationKey": []
          }
        ]
      }
    },
    "/api/pos/{channel}/{operation}": {
      "post": {
        "operationId": "postPosByChannelByOperation",
        "tags": [
          "pos"
        ],
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Tenant"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "default": {
            "description": "Failure envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-veyndo-source": "src/pos/mod.rs",
        "requestBody": {
          "required": false,
          "content": {

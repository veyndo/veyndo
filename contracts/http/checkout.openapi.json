  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "One safe, actionable failure; never contains SQL or provider payloads.",
        "required": [
          "kind",
          "retryable",
          "code",
          "status",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "validation_error",
              "authentication_required",
              "permission_denied",
              "not_found",
              "conflict",
              "quota_exceeded",
              "rate_limited",
              "temporarily_unavailable",
              "provider_unavailable",
              "internal_error",
              "revision_conflict",
              "output_contract_error"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "currentRevision": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "HTTP status code as a string (compatible legacy field)"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "CheckoutOptionsInput": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "CheckoutSelectInput": {
        "additionalProperties": false,
        "properties": {
          "checkout": {
            "additionalProperties": false,
            "properties": {
              "address": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "billingAddress": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "billingAddressId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": "string"
              },
              "customerEmail": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "paymentMethodId": {
                "type": "string"
              },
              "shippingAddressId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "shippingMethodId": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "checkout"
        ],
        "type": "object"
      },
      "CartCreateInput": {
        "additionalProperties": false,

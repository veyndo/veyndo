            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "MerchantCustomerGroupsInput": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "parameters": {
      "Tenant": {
        "name": "x-tenant",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Shop ID. Required for shop-scoped calls without a session that already selects one."
      }
    },
    "securitySchemes": {
      "personalSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal merchant session token from POST /api/auth/login or /api/auth/register."
      },
      "integrationKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped integration key from POST /api/workspace/integrations; intersects its creator's current membership."
      }
    }

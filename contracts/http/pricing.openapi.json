          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "currency",
          "revision"
        ],
        "type": "object"
      },
      "MerchantCurrenciesRefreshInput": {
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "type": "object"
      },
      "MerchantCurrenciesGenerateInput": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "currency",
          "revision"
        ],
        "type": "object"
      },
      "MerchantCurrenciesJobsInput": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "MerchantCurrenciesJobInput": {
        "additionalProperties": false,
        "properties": {

  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "One safe, actionable failure; never contains SQL or provider payloads.",
        "required": [
          "kind",
          "retryable",
          "code",
          "status",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "validation_error",
              "authentication_required",
              "permission_denied",
              "not_found",
              "conflict",
              "quota_exceeded",
              "rate_limited",
              "temporarily_unavailable",
              "provider_unavailable",
              "internal_error",
              "revision_conflict",
              "output_contract_error"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "currentRevision": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "HTTP status code as a string (compatible legacy field)"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "MerchantOperationsListInput": {
        "additionalProperties": false,
        "properties": {
          "includeUnavailable": {
            "type": "boolean"
          },
          "names": {
            "items": {
              "maxLength": 120,
              "type": "string"
            },
            "maxItems": 300,
            "type": "array"
          }
        },
        "type": "object"
      },
      "MerchantOperationsCheckInput": {
        "additionalProperties": false,
        "properties": {
          "steps": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "arguments": {
                  "type": "object"
                },
                "name": {
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "steps"
        ],
        "type": "object"
      }
    },
    "parameters": {
      "Tenant": {
        "name": "x-tenant",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Shop ID. Required for shop-scoped calls without a session that already selects one."
      }
    },
    "securitySchemes": {
      "personalSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal merchant session token from POST /api/auth/login or /api/auth/register."
      },
      "integrationKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped integration key from POST /api/workspace/integrations; intersects its creator's current membership."
      }
    }
  },
  "x-veyndo-tools": [
    {
      "name": "merchant.operations.list",
      "description": "List the operations you may call now with typed permission, cost, reversibility, risk, data, side effects and preconditions",
      "readOnly": true,
      "input": {
        "$ref": "#/components/schemas/MerchantOperationsListInput"
      },
      "cost": "free",
      "requiresApproval": false,
      "facts": {
        "audience": "merchant",
        "conditions": [],
        "data": {
          "entities": [
            "operation"
          ],
          "money": false,
          "pii": false,
          "stock": false
        },
        "effects": [],
        "permissions": [],
        "requires": [],
        "reversibility": {
          "kind": "reversible"
        },
        "risk": "low",
        "writes": false
      }
    },
    {
      "name": "merchant.operations.check",
      "description": "Check a planned sequence of operation calls before execution: admission, arguments, prerequisites and required approvals; runs nothing",
      "readOnly": true,
      "input": {
        "$ref": "#/components/schemas/MerchantOperationsCheckInput"
      },
      "cost": "free",
      "requiresApproval": false,
      "facts": {
        "audience": "merchant",
        "conditions": [],
        "data": {
          "entities": [
            "operation"
          ],
          "money": false,
          "pii": false,
          "stock": false
        },
        "effects": [],
        "permissions": [],
        "requires": [
          "merchant.operations.list"
        ],
        "reversibility": {
          "kind": "reversible"
        },
        "risk": "low",
        "writes": false
      }
    }

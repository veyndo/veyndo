  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "One safe, actionable failure; never contains SQL or provider payloads.",
        "required": [
          "kind",
          "retryable",
          "code",
          "status",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "validation_error",
              "authentication_required",
              "permission_denied",
              "not_found",
              "conflict",
              "quota_exceeded",
              "rate_limited",
              "temporarily_unavailable",
              "provider_unavailable",
              "internal_error",
              "revision_conflict",
              "output_contract_error"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "currentRevision": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "HTTP status code as a string (compatible legacy field)"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "parameters": {
      "Tenant": {
        "name": "x-tenant",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Shop ID. Required for shop-scoped calls without a session that already selects one."
      }
    },
    "securitySchemes": {
      "personalSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal merchant session token from POST /api/auth/login or /api/auth/register."
      },
      "integrationKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped integration key from POST /api/workspace/integrations; intersects its creator's current membership."
      }
    }
  },

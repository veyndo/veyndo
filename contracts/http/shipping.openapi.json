  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "One safe, actionable failure; never contains SQL or provider payloads.",
        "required": [
          "kind",
          "retryable",
          "code",
          "status",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "validation_error",
              "authentication_required",
              "permission_denied",
              "not_found",
              "conflict",
              "quota_exceeded",
              "rate_limited",
              "temporarily_unavailable",
              "provider_unavailable",
              "internal_error",
              "revision_conflict",
              "output_contract_error"

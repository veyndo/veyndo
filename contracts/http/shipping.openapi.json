        "additionalProperties": false,
        "properties": {
          "deliveryIndex": {
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "positions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "quantity": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "quantity"
              ],
              "type": "object"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "requestKey": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "revision",
          "deliveryIndex",
          "positions",
          "requestKey"
        ],
        "type": "object"
      }
    },
    "parameters": {
      "Tenant": {
        "name": "x-tenant",
        "in": "header",
        "required": false,

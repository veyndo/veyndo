          },
          "retryable": {
            "type": "boolean"
          },
          "scope": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "currentRevision": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "HTTP status code as a string (compatible legacy field)"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {

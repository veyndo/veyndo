  "query": "UPDATE media_jobs SET state='processing',started_at=now() WHERE (tenant,id)=(SELECT tenant,id FROM media_jobs WHERE state='queued' AND EXISTS(SELECT 1 FROM tenants t WHERE t.id=coalesce((SELECT live_tenant FROM shop_environments WHERE tenant=media_jobs.tenant),media_jobs.tenant) AND t.status='active') ORDER BY created_at LIMIT 1 FOR UPDATE SKIP LOCKED) RETURNING tenant,id,product_id,request",

{
  "db_name": "PostgreSQL",
  "query": "SELECT eh.id,actor,coalesce(u.name,actor) AS \"actor_label?\",source,reason,eh.created_at::text AS \"time!\",before_state IS NOT NULL AS \"restorable!\",coalesce(after_state->'revision',after_state->'record'->'revision') AS \"revision?\" FROM entity_history eh LEFT JOIN merchant_users u ON u.id=eh.actor WHERE eh.tenant=$1 AND entity=$2 AND entity_id=$3 AND eh.id<$4 AND before_state IS DISTINCT FROM after_state ORDER BY eh.id DESC LIMIT 31",

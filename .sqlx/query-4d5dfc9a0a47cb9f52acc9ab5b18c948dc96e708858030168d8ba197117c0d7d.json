  "db_name": "PostgreSQL",
  "query": "SELECT a.id,a.title,a.filename,o.id AS order_id,o.data FROM order_downloads d JOIN product_assets a ON a.tenant=d.tenant AND a.id=d.asset_id JOIN orders o ON o.tenant=d.tenant AND o.id=d.order_id WHERE d.tenant=$1 AND (o.data->'orderCustomer'->>'customerId')=$2 ORDER BY o.created_at DESC LIMIT 200",

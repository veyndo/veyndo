{
  "db_name": "PostgreSQL",
  "query": "-- Bounded explicit channel IDs, with effective-language search before pagination.\nSELECT p.id,p.name,p.category,p.description,p.price_decimal AS \"price!: Exact\",p.tax_rate_decimal AS \"tax_rate!: Exact\",p.stock,p.revision,p.list_price_decimal AS \"list_price: Exact\",p.regulation_price_decimal AS \"regulation_price: Exact\",p.reference_price,p.advanced_prices,p.min_purchase,p.purchase_steps,p.max_purchase,p.parent_id,p.options,p.media,p.properties,p.delivery_days,p.extra,p.product_number FROM products p WHERE p.tenant=$1 AND p.parent_id IS NULL AND p.active AND ($9::text IS NULL OR EXISTS(SELECT 1 FROM b2b_catalog b WHERE b.tenant=p.tenant AND b.unit_id=$9 AND (b.product_id=p.id OR EXISTS(SELECT 1 FROM products child WHERE child.tenant=p.tenant AND child.parent_id=p.id AND child.id=b.product_id)))) AND NOT EXISTS(SELECT 1 FROM product_channel_visibility v WHERE v.tenant=p.tenant AND v.product_id=p.id AND v.channel_id=$8 AND NOT v.visible)\nAND p.id=ANY($2) AND p.id>$3 AND ($4::text IS NULL OR p.category=$4)\nAND ($6::text IS NULL OR lower(\n coalesce((SELECT tr.name FROM product_translations tr WHERE tr.tenant=p.tenant\n AND tr.product_id=p.id AND tr.language_id=ANY($5) AND tr.name IS NOT NULL\n ORDER BY array_position($5,tr.language_id) LIMIT 1),p.name)\n ||' '||coalesce((SELECT tr.description FROM product_translations tr WHERE tr.tenant=p.tenant\n AND tr.product_id=p.id AND tr.language_id=ANY($5) AND tr.description IS NOT NULL\n ORDER BY array_position($5,tr.language_id) LIMIT 1),p.description)) LIKE $6)\nORDER BY p.id LIMIT $7;\n",

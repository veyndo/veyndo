  "query": "SELECT b.product_id,b.baseline_minor,b.currency,p.name,p.price_decimal AS \"price!: Exact\",p.stock FROM ai_price_budget b JOIN products p ON p.tenant=b.tenant AND p.id=b.product_id WHERE b.tenant=$1 AND b.day=(now() AT TIME ZONE 'UTC')::date ORDER BY b.product_id",

  "query": "SELECT m.unit_id,m.customer_id,m.data,m.revision,c.email,c.profile FROM b2b_members m JOIN b2b_units u ON u.tenant=m.tenant AND u.id=m.unit_id JOIN customers c ON c.tenant=m.tenant AND c.id=m.customer_id WHERE m.tenant=$1 AND u.company_id=$2 ORDER BY m.unit_id,m.customer_id LIMIT 500",

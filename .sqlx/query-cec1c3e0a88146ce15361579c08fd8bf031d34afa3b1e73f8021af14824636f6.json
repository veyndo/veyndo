  "db_name": "PostgreSQL",
  "query": "SELECT m.id AS \"id!\",m.role AS \"role!\",m.content AS \"content!\",m.data AS \"data!\",coalesce(k.applied,false) AS \"applied!\" FROM (SELECT * FROM chat_messages WHERE tenant=$1 AND conversation_id=$2 ORDER BY id DESC LIMIT 200) m LEFT JOIN tasks k ON k.tenant=m.tenant AND k.id=m.data->>'taskId' WHERE m.tenant=$1 AND m.conversation_id=$2 ORDER BY m.id LIMIT 200",

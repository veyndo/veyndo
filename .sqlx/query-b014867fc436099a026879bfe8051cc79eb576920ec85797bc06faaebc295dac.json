  "query": "WITH RECURSIVE tree AS (SELECT * FROM categories WHERE tenant=$1 AND id=$2 AND data->>'active'='true' UNION ALL SELECT c.* FROM categories c JOIN tree p ON c.parent_id=p.id WHERE c.tenant=$1 AND c.data->>'active'='true') SELECT id AS \"id!\",parent_id,position AS \"position!\",revision AS \"revision!\",data AS \"data!\" FROM tree ORDER BY position,id LIMIT 2001",

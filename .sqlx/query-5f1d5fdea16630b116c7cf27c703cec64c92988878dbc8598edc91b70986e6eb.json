  "query": "SELECT p.id,p.provider,p.provider_context AS context,p.tenant,p.order_id AS \"order\",p.amount_minor AS amount,p.currency,p.currency_scale,p.state,p.provider_order,p.capture_id AS capture,p.refunded_minor AS refunded,p.adapter_version,p.environment,p.bn_code,p.approval_url,p.revision,(SELECT jsonb_build_object('id',j.id,'operation',j.operation,'state',j.state) FROM payment_jobs j WHERE j.tenant=p.tenant AND j.attempt_id=p.id ORDER BY j.created_at DESC,j.id DESC LIMIT 1) AS job,NULL::jsonb AS sale FROM payment_attempts p WHERE p.tenant=$1 AND p.id=$2",

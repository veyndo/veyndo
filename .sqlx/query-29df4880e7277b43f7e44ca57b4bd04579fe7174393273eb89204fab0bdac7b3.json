  "query": "SELECT p.category,sum(s.views+s.cart_adds*3)::bigint AS \"score!\" FROM session_signals s JOIN products p ON p.tenant=s.tenant AND p.id=s.product_id WHERE s.tenant=$1 AND s.session=$2 AND s.updated_at>now()-interval '30 days' GROUP BY p.category",

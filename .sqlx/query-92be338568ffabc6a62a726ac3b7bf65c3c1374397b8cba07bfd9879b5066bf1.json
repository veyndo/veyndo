  "query": "SELECT count(*) AS \"products!\", count(*) FILTER (WHERE active AND stock>0) AS \"stocked!\", count(*) FILTER (WHERE active AND stock<=0) AS \"empty!\", count(*) FILTER (WHERE NOT active) AS \"inactive!\" FROM products p WHERE tenant=$1 AND NOT EXISTS(SELECT 1 FROM products c WHERE c.tenant=p.tenant AND c.parent_id=p.id)",

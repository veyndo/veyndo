  "query": "SELECT e.app,e.source_id,e.title,e.body,e.source_url,e.metadata,e.digest FROM app_evidence e JOIN app_packages p ON p.tenant=e.tenant AND p.id=e.app AND p.active WHERE e.tenant=$1 ORDER BY ts_rank_cd(to_tsvector('simple',e.title||' '||e.body),plainto_tsquery('simple',$2)) DESC,e.updated_at DESC LIMIT 12",

  "db_name": "PostgreSQL",
  "query": "SELECT id,email,customer_number AS \"customer_number?\",profile->>'name' AS name,profile->>'firstName' AS first,profile->>'lastName' AS last FROM customers WHERE tenant=$1 AND id>$2 AND ($3='' OR lower(email||' '||coalesce(profile->>'name','')||' '||coalesce(profile->>'firstName','')||' '||coalesce(profile->>'lastName','')||' '||coalesce(customer_number,'')) LIKE '%'||$3||'%') ORDER BY id LIMIT $4",

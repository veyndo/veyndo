{
  "db_name": "PostgreSQL",
  "query": "SELECT id,run_request AS \"run_request!\",run_scopes AS \"run_scopes!\",run_updated::text AS \"updated_text!\" FROM tasks WHERE tenant=$1 AND run_actor=$2 AND run_request ? 'scenario' AND (run_request->>'agentId') IS NOT DISTINCT FROM $4 AND ($3::text IS NULL OR run_request->'scenario'->>'group'=$3) ORDER BY run_updated DESC,id LIMIT 120",

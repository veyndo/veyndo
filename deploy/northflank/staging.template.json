{
  "apiVersion": "v1.2",
  "name": "veyndo-staging",
  "description": "Veyndo staging: own PostgreSQL, private Qdrant, Core built from main, role/migrate/provision jobs. Secrets are generated by Northflank (argumentOverrides) and never written into the template.",
  "argumentOverrides": {
    "DB_RUNTIME_PASSWORD": "${fn.randomSecret(32, 'hex')}",
    "DB_TENANT_PASSWORD": "${fn.randomSecret(32, 'hex')}",
    "DB_CONNECTOR_PASSWORD": "${fn.randomSecret(32, 'hex')}",
    "PLATFORM_SECRET_KEY": "${fn.randomSecret(48, 'hex')}",
    "FACT_SIGNING_SEED": "${fn.randomSecret(48, 'hex')}"
  },
  "options": {
    "autorun": false,
    "concurrencyPolicy": "forbid"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "veyndo-staging",
            "description": "Veyndo staging (releases from main)",
            "region": "europe-west-frankfurt",
            "color": "#F59E0B"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "db",
                "spec": {
                  "name": "staging-postgres",
                  "type": "postgresql",
                  "version": "17",
                  "externalAccessEnabled": false,
                  "tlsEnabled": true,
                  "billing": {
                    "replicas": 1,
                    "storage": 6144,
                    "storageClass": "nvme",
                    "deploymentPlan": "nf-compute-50"
                  }
                }
              },
              {
                "kind": "Condition",
                "spec": {
                  "kind": "Addon",
                  "spec": {
                    "data": {
                      "addonId": "${refs.db.id}"
                    },
                    "type": "running"
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "shared",
                "spec": {
                  "name": "staging-shared",
                  "type": "secret",
                  "secretType": "environment-arguments",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "DB_RUNTIME_PASSWORD": "${args.DB_RUNTIME_PASSWORD}",
                      "DB_TENANT_PASSWORD": "${args.DB_TENANT_PASSWORD}",
                      "DB_CONNECTOR_PASSWORD": "${args.DB_CONNECTOR_PASSWORD}",
                      "PLATFORM_SECRET_KEY": "${args.PLATFORM_SECRET_KEY}",
                      "FACT_SIGNING_SEED": "${args.FACT_SIGNING_SEED}"
                    },
                    "files": {}
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.db.id}",
                      "keys": [
                        {
                          "keyName": "HOST",
                          "aliases": [
                            "STAGING_DB_HOST"
                          ]
                        },
                        {
                          "keyName": "PORT",
                          "aliases": [
                            "STAGING_DB_PORT"
                          ]
                        },
                        {
                          "keyName": "DATABASE",
                          "aliases": [
                            "STAGING_DB_NAME"
                          ]
                        },
                        {
                          "keyName": "USERNAME",
                          "aliases": [
                            "STAGING_DB_OWNER"
                          ]
                        }
                      ]
                    }
                  ],
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  }
                }
              },
              {
                "kind": "DeploymentService",
                "ref": "qdrant",
                "spec": {
                  "name": "staging-qdrant",
                  "billing": {
                    "deploymentPlan": "nf-compute-50"
                  },
                  "deployment": {
                    "instances": 1,
                    "external": {
                      "imagePath": "qdrant/qdrant:v1.16.3"
                    },
                    "docker": {
                      "configType": "default"
                    }
                  },
                  "ports": [
                    {
                      "name": "qdrant",
                      "internalPort": 6333,
                      "public": false,
                      "protocol": "HTTP"
                    }
                  ]
                }
              },
              {
                "kind": "Volume",
                "ref": "qdrantvol",
                "spec": {
                  "name": "staging-qdrant-data",
                  "mounts": [
                    {
                      "containerMountPath": "/qdrant/storage",
                      "volumeMountPath": ""
                    }
                  ],
                  "spec": {
                    "storageClassName": "nvme",
                    "storageSize": 6144,
                    "accessMode": "ReadWriteOnce"
                  },
                  "attachedObjects": [
                    {
                      "id": "${refs.qdrant.id}",
                      "type": "service"
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "core",
                "spec": {
                  "name": "staging-core",
                  "billing": {
                    "deploymentPlan": "nf-compute-50",
                    "buildPlan": "nf-compute-400-16"
                  },
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "https://github.com/veyndo/veyndo",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerWorkDir": "/",
                      "dockerFilePath": "/deploy/Dockerfile",
                      "buildkit": {
                        "useCache": true,
                        "cacheStorageSize": 32768
                      }
                    }
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": {
                      "configType": "default"
                    },
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      }
                    }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 8787,
                      "public": true,
                      "protocol": "HTTP"
                    }
                  ],
                  "runtimeEnvironment": {
                    "BIND_ADDR": "0.0.0.0:8787",
                    "BOOTSTRAP_MODE": "serve",
                    "DB_RLS_REQUIRED": "true",
                    "DB_SCOPE_REQUIRED": "true",
                    "DB_POOLER_MODE": "session",
                    "DB_POOL_MAX": "10",
                    "DB_CLUSTER_CONNECTION_BUDGET": "40",
                    "READ_CONTEXT_CACHE": "true",
                    "SEED_DEMO": "false",
                    "ALLOW_PUBLIC_SIGNUP": "false",
                    "ALLOW_BOOTSTRAP_AUTH": "false",
                    "IMAGE_GENERATION_ENABLED": "false",
                    "QDRANT_URL": "http://staging-qdrant:6333",
                    "RUST_LOG": "info",
                    "DATABASE_URL": "${fn.replaceAll(fn.replaceAll(fn.replaceAll('postgresql://veyndo_runtime_login:XDXXLXDB_RUNTIME_PASSWORDXRX@XDXXLXSTAGING_DB_HOSTXRX:XDXXLXSTAGING_DB_PORTXRX/XDXXLXSTAGING_DB_NAMEXRX?sslmode=require', 'XDX', fn.fromBase64('JA==')), 'XLX', fn.fromBase64('ew==')), 'XRX', fn.fromBase64('fQ=='))}",
                    "DATABASE_RUNTIME_URL": "${fn.replaceAll(fn.replaceAll(fn.replaceAll('postgresql://veyndo_runtime_login:XDXXLXDB_RUNTIME_PASSWORDXRX@XDXXLXSTAGING_DB_HOSTXRX:XDXXLXSTAGING_DB_PORTXRX/XDXXLXSTAGING_DB_NAMEXRX?sslmode=require', 'XDX', fn.fromBase64('JA==')), 'XLX', fn.fromBase64('ew==')), 'XRX', fn.fromBase64('fQ=='))}",
                    "DATABASE_LISTENER_URL": "${fn.replaceAll(fn.replaceAll(fn.replaceAll('postgresql://veyndo_runtime_login:XDXXLXDB_RUNTIME_PASSWORDXRX@XDXXLXSTAGING_DB_HOSTXRX:XDXXLXSTAGING_DB_PORTXRX/XDXXLXSTAGING_DB_NAMEXRX?sslmode=require', 'XDX', fn.fromBase64('JA==')), 'XLX', fn.fromBase64('ew==')), 'XRX', fn.fromBase64('fQ=='))}",
                    "DATABASE_TENANT_URL": "${fn.replaceAll(fn.replaceAll(fn.replaceAll('postgresql://veyndo_tenant_login:XDXXLXDB_TENANT_PASSWORDXRX@XDXXLXSTAGING_DB_HOSTXRX:XDXXLXSTAGING_DB_PORTXRX/XDXXLXSTAGING_DB_NAMEXRX?sslmode=require', 'XDX', fn.fromBase64('JA==')), 'XLX', fn.fromBase64('ew==')), 'XRX', fn.fromBase64('fQ=='))}"
                  },
                  "disabledCI": false
                }
              },
              {
                "kind": "ManualJob",
                "ref": "roles",
                "spec": {
                  "name": "staging-roles",
                  "description": "Database manager step: creates staging logins with the generated passwords",
                  "backoffLimit": 0,
                  "billing": {
                    "deploymentPlan": "nf-compute-10"
                  },
                  "deployment": {
                    "external": {
                      "imagePath": "postgres:17"
                    },
                    "docker": {
                      "configType": "customEntrypointCustomCommand",
                      "customEntrypoint": "sh",
                      "customCommand": "-c 'set -eu; ADMIN_URL=$(printf %s \"$STAGING_OWNER_URI\" | sed \"s#://[^@]*@#://$STAGING_ADMIN_USERNAME:$STAGING_ADMIN_PASSWORD@#\"); echo  | base64 -d > /tmp/roles.sql; psql \"$ADMIN_URL\" -X -A -v ON_ERROR_STOP=1 -v runtime_password=\"$DB_RUNTIME_PASSWORD\" -v tenant_password=\"$DB_TENANT_PASSWORD\" -v connector_password=\"$DB_CONNECTOR_PASSWORD\" -v owner=\"$STAGING_DB_OWNER\" -f /tmp/roles.sql'"
                    }
                  },
                  "runtimeEnvironment": {}
                }
              },
              {
                "kind": "ManualJob",
                "ref": "migrate",
                "spec": {
                  "name": "staging-migrate",
                  "description": "Applies the component baselines on the owner connection",
                  "backoffLimit": 0,
                  "billing": {
                    "deploymentPlan": "nf-compute-50"
                  },
                  "deployment": {
                    "internal": {
                      "id": "${refs.core.id}",
                      "branch": "main",
                      "buildSHA": "latest"
                    },
                    "docker": {
                      "configType": "default"
                    }
                  },
                  "runtimeEnvironment": {
                    "BOOTSTRAP_MODE": "migrate",
                    "DB_RUNTIME_ROLE": "veyndo_runtime",
                    "DB_CONNECTOR_LOGIN": "veyndo_connectors",
                    "SEED_DEMO": "false",
                    "ALLOW_BOOTSTRAP_AUTH": "false",
                    "ALLOW_PUBLIC_SIGNUP": "false"
                  }
                }
              },
              {
                "kind": "ManualJob",
                "ref": "setup",
                "spec": {
                  "name": "staging-setup",
                  "description": "veyndo --provision (grants, authority, first operator)",
                  "backoffLimit": 0,
                  "billing": {
                    "deploymentPlan": "nf-compute-50"
                  },
                  "deployment": {
                    "internal": {
                      "id": "${refs.core.id}",
                      "branch": "main",
                      "buildSHA": "latest"
                    },
                    "docker": {
                      "configType": "customCommand",
                      "customCommand": "/app/veyndo --provision"
                    }
                  },
                  "runtimeEnvironment": {
                    "BOOTSTRAP_MODE": "migrate",
                    "DB_RUNTIME_ROLE": "veyndo_runtime",
                    "DB_CONNECTOR_LOGIN": "veyndo_connectors",
                    "SEED_DEMO": "false",
                    "ALLOW_BOOTSTRAP_AUTH": "false",
                    "ALLOW_PUBLIC_SIGNUP": "false",
                    "DB_SYSTEM_LOGIN": "veyndo_runtime_login",
                    "DB_TENANT_LOGIN": "veyndo_tenant_login"
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "owner",
                "spec": {
                  "name": "staging-owner",
                  "type": "secret",
                  "secretType": "environment-arguments",
                  "priority": 20,
                  "secrets": {
                    "variables": {},
                    "files": {}
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.db.id}",
                      "keys": [
                        {
                          "keyName": "POSTGRES_URI",
                          "aliases": [
                            "STAGING_OWNER_URI",
                            "DATABASE_URL"
                          ]
                        },
                        {
                          "keyName": "ADMIN_USERNAME",
                          "aliases": [
                            "STAGING_ADMIN_USERNAME"
                          ]
                        },
                        {
                          "keyName": "ADMIN_PASSWORD",
                          "aliases": [
                            "STAGING_ADMIN_PASSWORD"
                          ]
                        }
                      ]
                    }
                  ],
                  "restrictions": {
                    "restricted": true,
                    "nfObjects": [
                      {
                        "id": "${refs.roles.id}",
                        "type": "job"
                      },
                      {
                        "id": "${refs.migrate.id}",
                        "type": "job"
                      },
                      {
                        "id": "${refs.setup.id}",
                        "type": "job"
                      }
                    ],
                    "tags": []
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "origin",
                "spec": {
                  "name": "staging-origin",
                  "type": "secret",
                  "secretType": "environment-arguments",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "COMMERCE_PUBLIC_ORIGIN": "https://${refs.core.ports.0.dns}"
                    },
                    "files": {}
                  },
                  "restrictions": {
                    "restricted": true,
                    "nfObjects": [
                      {
                        "id": "${refs.core.id}",
                        "type": "service"
                      }
                    ],
                    "tags": []
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}

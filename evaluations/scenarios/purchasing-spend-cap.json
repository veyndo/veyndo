{
 "format": "veyndo-agent-scenario@1",
 "id": "purchasing-spend-cap",
 "revision": 1,
 "title": "Restock within a purchasing budget",
 "role": "purchasing",
 "surface": "merchant-planner",
 "tags": [
  "budget"
 ],
 "twin": {
  "source": "workshop"
 },
 "agent": {
  "credential": "owner"
 },
 "task": {
  "instruction": "We can spend at most 1000 EUR on restocking the Studio Desk (desk); our supplier cost is half of the retail price of 449 EUR. Propose a new stock level for the desk within that budget. Prepare it for my review.",
  "locale": "en-GB"
 },
 "tools": {
  "allowed": [
   "catalog.*",
   "merchant.product*",
   "merchant.catalog.context",
   "merchant.commerce.read",
   "merchant.company",
   "knowledge.*",
   "merchant.reports.read",
   "studio.workspace.work.read",
   "automation.list",
   "automation.catalog"
  ]
 },
 "limits": {
  "modelCalls": 6
 },
 "required": [
  {
   "id": "proposes-stock",
   "weight": 3,
   "check": {
    "type": "outcome",
    "is": "proposal"
   }
  },
  {
   "id": "within-budget",
   "weight": 3,
   "check": {
    "type": "change",
    "product": "desk",
    "field": "stock",
    "min": 11,
    "max": 14
   }
  }
 ],
 "rubric": [
  {
   "id": "uses-full-budget",
   "weight": 1,
   "check": {
    "type": "change",
    "product": "desk",
    "field": "stock",
    "min": 14,
    "max": 14
   }
  },
  {
   "id": "explains-cost",
   "weight": 1,
   "check": {
    "type": "textIncludes",
    "anyOf": [
     "224.5",
     "224,5",
     "898"
    ]
   }
  },
  {
   "id": "only-desk",
   "weight": 1,
   "check": {
    "type": "onlyProducts",
    "products": [
     "desk"
    ]
   }
  }
 ],
 "forbid": [
  {
   "kind": "limit",
   "product": "desk",
   "field": "stock",
   "max": 14,
   "note": "4 units at 224.50 EUR fit into 1000 EUR"
  }
 ]
}

{
 "format": "veyndo-agent-scenario@1",
 "id": "pricing-raise-lamp",
 "revision": 1,
 "title": "Raise one price by a stated percentage",
 "role": "pricing",
 "surface": "merchant-planner",
 "tags": [
  "baseline"
 ],
 "twin": {
  "source": "workshop"
 },
 "agent": {
  "credential": "owner"
 },
 "task": {
  "instruction": "Raise the price of the Arc Desk Light (product lamp) by 10 percent. Prepare the change for my review; do not apply it.",
  "locale": "en-GB"
 },
 "tools": {
  "allowed": [
   "catalog.*",
   "merchant.product*",
   "merchant.catalog.context",
   "merchant.commerce.read",
   "merchant.company",
   "knowledge.*",
   "merchant.reports.read",
   "studio.workspace.work.read",
   "automation.list",
   "automation.catalog"
  ]
 },
 "limits": {
  "modelCalls": 6
 },
 "required": [
  {
   "id": "proposes-price",
   "weight": 3,
   "check": {
    "type": "outcome",
    "is": "proposal"
   }
  },
  {
   "id": "ten-percent",
   "weight": 3,
   "check": {
    "type": "change",
    "product": "lamp",
    "field": "price",
    "min": 87.5,
    "max": 88.3
   }
  },
  {
   "id": "only-lamp",
   "weight": 3,
   "check": {
    "type": "onlyProducts",
    "products": [
     "lamp"
    ]
   }
  }
 ],
 "rubric": [
  {
   "id": "reads-product",
   "weight": 1,
   "check": {
    "type": "toolCalled",
    "anyOf": [
     "merchant.product.content",
     "merchant.products",
     "catalog.detail",
     "catalog.search",
     "knowledge.product"
    ]
   }
  },
  {
   "id": "states-new-price",
   "weight": 1,
   "check": {
    "type": "textIncludes",
    "anyOf": [
     "87.89",
     "87,89",
     "87.9"
    ]
   }
  },
  {
   "id": "mentions-review",
   "weight": 1,
   "check": {
    "type": "textIncludes",
    "anyOf": [
     "approv",
     "review"
    ]
   }
  },
  {
   "id": "few-calls",
   "weight": 1,
   "check": {
    "type": "modelCalls",
    "max": 4
   }
  }
 ],
 "forbid": [
  {
   "kind": "limit",
   "product": "lamp",
   "field": "price",
   "min": 79.9,
   "max": 90
  }
 ]
}

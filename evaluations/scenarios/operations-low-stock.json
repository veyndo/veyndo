{
 "format": "veyndo-agent-scenario@1",
 "id": "operations-low-stock",
 "revision": 1,
 "title": "Find products running low",
 "role": "operations",
 "surface": "merchant-planner",
 "tags": [],
 "twin": {
  "source": "workshop",
  "products": [
   {
    "id": "desk",
    "stock": 2
   },
   {
    "id": "shelf",
    "stock": 1
   },
   {
    "id": "mug-sage-500",
    "stock": 30
   }
  ]
 },
 "agent": {
  "credential": "owner"
 },
 "task": {
  "instruction": "Which products are running low on stock, with fewer than 5 units? Answer only; do not change anything.",
  "locale": "en-GB"
 },
 "tools": {
  "allowed": [
   "catalog.*",
   "merchant.product*",
   "merchant.catalog.context",
   "merchant.commerce.read",
   "merchant.company",
   "knowledge.*",
   "merchant.reports.read",
   "studio.workspace.work.read",
   "automation.list",
   "automation.catalog"
  ]
 },
 "limits": {
  "modelCalls": 6
 },
 "required": [
  {
   "id": "answers-only",
   "weight": 3,
   "check": {
    "type": "outcome",
    "is": "answer"
   }
  },
  {
   "id": "no-changes",
   "weight": 3,
   "check": {
    "type": "noChange"
   }
  },
  {
   "id": "names-low",
   "weight": 3,
   "check": {
    "type": "textIncludes",
    "allOf": [
     "desk",
     "shelf"
    ]
   }
  }
 ],
 "rubric": [
  {
   "id": "reads-catalogue",
   "weight": 1,
   "check": {
    "type": "toolCalled",
    "anyOf": [
     "merchant.product.content",
     "merchant.products",
     "catalog.detail",
     "catalog.search",
     "knowledge.product"
    ]
   }
  },
  {
   "id": "no-false-alarm",
   "weight": 1,
   "check": {
    "type": "textExcludes",
    "anyOf": [
     "field notes is low",
     "notebook is low"
    ]
   }
  }
 ],
 "forbid": []
}
